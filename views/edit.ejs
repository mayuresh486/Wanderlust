<% layout("/layouts/boilerPlater.ejs")%>
<div class="row mt-3">
    <div class="col-8">
    <h3>Edit your Listing</h3>
    <form method="POST" action="/listing/<%=listing.id  %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="from-label">Title</label>
            <input value="<%= listing.title %>" name="listing[title]" type="text" class="form-control"/>
            <div class="valid-feedback">Title looks good!</div>
        </div>
        <div class="mb-3">
            <label for="description" class="from-label">Description</label>
            <textarea value="<%= listing.description %>" name="listing[description]" type="text" class="form-control"></textarea>
            <div class="invalid-feedback">Please enter short description</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Upload New Image</label>
            <input name="listing[image]" type="file" class="form-control"></input>
        </div>
        <div class="row">
        <div class="mb-3 col-4">
            <label for="price" class="from-label">Price</label>
            <input value="<%= listing.price %>" name="listing[price]" type="number" class="form-control"/>
            <div class="invalid-feedback">Price should be valid</div>
        </div>
        <div class="mb-3 col-8">
            <label for="location" class="from-label">Location</label>
            <input value="<%= listing.location %>" name="listing[location]" type="text" class="form-control"/>
            <div class="invalid-feedback">Location should be valid</div>
        </div>
        </div>
        <div class="mb-3">
            <label for="country" class="from-label">Country</label>
            <input value="<%= listing.country %>" name="listing[country]" type="text" class="form-control"/>
            <div class="invalid-feedback">Country name should be valid</div>
        </div>
        <button class="btn btn-dark add-btn mt-3">Add</button>
    </form>
    </div>
</div>