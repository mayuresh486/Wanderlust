<%if(success && success.length){%>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3 mt-30" role="alert">
  <%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>
<% if (errors && errors.length) { %>
    <div class="alert alert-warning alert-dismissible fade show col-6 offset-3 mt-30" role="alert">
    <%= errors %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>